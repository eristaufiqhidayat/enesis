APP_NAME="Enesis Canvassing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# pgsql (port 5432, user postgres) atau mysql (port 3306, user root)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=enesis
DB_USERNAME=postgres
DB_PASSWORD=

# Folder hasil ekstrak marketama_csv_import_*.zip untuk MarketamaDataSeeder
MARKETAMA_DATA_PATH=

# Akun admin aplikasi lama untuk: php artisan marketama:tarik (isi hanya di server, jangan di-commit)
MARKETAMA_URL=https://app.cnvmarketama.com
MARKETAMA_USERNAME=
MARKETAMA_PASSWORD=
MARKETAMA_JEDA_MS=300

# Batas wilayah resmi untuk Generate Polygon Kelurahan & Auto Grid.
# Sumber utama: big = layanan peta Badan Informasi Geospasial (geoservices.big.go.id);
# kemendagri-2025 = dataset cahyadsn/wilayah_boundaries. Cadangan mengisi kelurahan yang tidak ada di sumber utama.
BATAS_WILAYAH_SUMBER=big
BATAS_WILAYAH_CADANGAN=kemendagri-2025
# Penyederhanaan geometri BIG dalam derajat (0.00001 ≈ 1 m); kosong = geometri asli.
BATAS_WILAYAH_BIG_SEDERHANAKAN=
# Dataset: kosongkan untuk mengunduh per kota dari GitHub; isi BATAS_WILAYAH_DIR bila server tanpa internet
# (folder "db" hasil git clone dataset), atau BATAS_WILAYAH_URL untuk mirror internal.
BATAS_WILAYAH_URL=
BATAS_WILAYAH_DIR=

# Master wilayah resmi (php artisan wilayah:sinkron-resmi): API relasi kode BPS–Kemendagri.
# Periode relasi (parameter periode_merge BPS); kosong = terbaru.
WILAYAH_BPS_PERIODE=
WILAYAH_BPS_PARALEL=4

# Password akun "admin" dari UserSeeder di production (kosong = tidak dibuat di production;
# di lokal default "password").
SEED_ADMIN_PASSWORD=

# Tombol "Demo masuk cepat" di halaman login (masuk tanpa password sebagai akun demo per peran).
# Bawaan hanya aktif bila APP_ENV=local. JANGAN true di server yang berisi data asli.
DEMO_LOGIN=

# API aplikasi mobile (/api/mobile/v1). Nilai (konfirmasi) bisa diubah tanpa ubah kode.
MOBILE_VERSI_MINIMUM=1.0.0
MOBILE_RADIUS_DEPO_M=100
MOBILE_RADIUS_OUTLET_M=100
MOBILE_RADIUS_DUPLIKAT_M=20
MOBILE_JAM_AKTIF_MULAI=06:00
MOBILE_JAM_AKTIF_SELESAI=21:00
MOBILE_BATAS_MASUK=08:00
MOBILE_CHECKIN_PAGI_MULAI=09:00
MOBILE_CHECKIN_PAGI_SELESAI=11:00
MOBILE_MINIMAL_TRANSAKSI=35000
MOBILE_POIN_PRODUK_FOKUS=0
MOBILE_ABSEN_CEK_LOKASI=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
